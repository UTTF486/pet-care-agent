# ===================================================================
# 复制本文件为 .env，按需填写。不填也能跑（离线兜底模式）
# ===================================================================

# ---------------- 大模型 ----------------
# auto（默认）: 配了谁用谁，都没配就走离线兜底
# deepseek / dashscope / ark / compat / mock: 强制指定
LLM_PROVIDER=auto

# ① DeepSeek（推荐：便宜、国内直连、中文表现好）
# 获取: https://platform.deepseek.com/api_keys → 创建 API key
# 注意完整 Key 是 sk- 开头的一长串，不是 UUID
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ② 通义千问（阿里云百炼），免费额度足够做项目
# 申请: https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# ③ 火山方舟（豆包），Key 是 UUID 格式；模型名填推理接入点 ID(ep-xxxx) 或模型名
# 申请: https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=
ARK_MODEL=doubao-pro-32k

# 通用 OpenAI 兼容端点：魔搭 / 硅基流动 / 各类中转站都能接
# 只要平台提供 /v1/chat/completions，填下面三行即可，不用改代码
# 魔搭示例（每天有免费额度）：https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# ---------------- 向量化 ----------------
# local: 内置轻量向量（默认，离线可用，不下载模型）
# dashscope: text-embedding-v3（需要 Key，语义效果更好）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=768

# ---------------- 检索 ----------------
RETRIEVAL_TOP_K=4
CHUNK_SIZE=380
CHUNK_OVERLAP=60
# 混合分（0.65*词项覆盖率 + 0.35*余弦）的阈值，不是纯余弦！
# 相关片段约 0.15-0.45，无关片段约 0.03-0.12
MIN_SIMILARITY=0.12

# ---------------- 业务联动 ----------------
# 宠物服务上门平台前端地址（本地开发默认 5173）
PLATFORM_BASE_URL=http://localhost:5173
RECOMMEND_TOP_N=2

# ---------------- 调试 ----------------
VERBOSE=false
MAX_HISTORY_TURNS=6
